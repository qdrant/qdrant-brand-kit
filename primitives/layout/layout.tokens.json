            "$type": "number",
            "$value": 1.4
          },
          "max": {
            "$type": "number",
            "$value": 3
          }
        },
        "reference": {
          "width": {
            "$type": "dimension",
            "$value": "1920px"
          },
          "height": {
            "$type": "dimension",
            "$value": "1080px"
