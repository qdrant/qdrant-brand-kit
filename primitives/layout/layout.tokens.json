{
  "$description": "Qdrant canvas layout for social posts and other image canvases. All dimensions are px at the shape's reference canvas; at other sizes multiply by the scale. Web page layout stays in spacing/ (layout.*). Grid columns derived for this primitive (2026-11-04), not from Figma or the brand skill.",
  "canvas": {
    "scale": {
      "$type": "string",
      "$value": "min(width / reference.width, height / reference.height)",
      "$description": "How px at the reference canvas map to the real size."
    },
    "shape": {
      "ultrawide": {
        "ratio": {
          "$description": "Width / height above 3.",
          "min": {
            "$type": "number",
            "$value": 3
          }
        },
        "reference": {
          "width": {
            "$type": "dimension",
            "$value": "3000px"
          },
          "height": {
            "$type": "dimension",
            "$value": "400px"
          }
        },
        "margin": {
          "x": {
            "$type": "dimension",
            "$value": "96px"
          },
          "top": {
            "$type": "dimension",
            "$value": "48px"
          },
          "bottom": {
            "$type": "dimension",
            "$value": "48px"
          }
        },
        "grid": {
          "columns": {
            "$type": "number",
            "$value": 12
          },
          "column": {
            "$type": "dimension",
            "$value": "190px"
          },
          "gutter": {
            "$type": "dimension",
            "$value": "48px"
          }
        },
        "gap": {
          "tight": {
            "$type": "dimension",
            "$value": "16px"
          },
          "group": {
            "$type": "dimension",
            "$value": "32px"
          },
          "section": {
