          },
          "section": {
            "$type": "dimension",
            "$value": "64px"
          }
        }
      }
    },
    "gap": {
      "$description": "Pick the role, then read the value for the shape. tight: things that belong together (icon + text, name + role, date + time). group: items in one block (eyebrow + title + body, a row of speakers). section: separate blocks (header vs speakers, text vs logo lockup)."
    }
  },
  "box": {
    "$description": "Dark theme only (colors/: light is for print, documents and light-mode UIs). Each nested card is one elevation step lighter; at most two levels.",
    "padding": {
      "$type": "string",
      "$value": "canvas.shape.*.gap.group"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.md}",
      "$description": "At the reference canvas."
    },
    "border-width": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "At the reference canvas, never thinner than 1px."
    },
    "card": {
      "background": {
        "$type": "color",
        "$value": "{semantic.color.background.surface}",
        "$description": "Level 1: a card on the canvas."
      },
      "background-nested": {
        "$type": "color",
        "$value": "{semantic.color.background.surface-raised}",
        "$description": "Level 2: a card inside a card."
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.on-dark}"
      }
    },
    "outline": {
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.on-dark}",
        "$description": "Border only, no fill. Cells in a joined grid share their lines."
      }
    }
  },
  "print": {
    "$description": "Not defined yet. Print sizes, bleed and safe area come here once the social side is approved."
  }
}
