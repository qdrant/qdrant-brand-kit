{
  "$description": "Qdrant typography. Weights and the size and line-height scales match the Figma file Qdrant Design System Primitives (UUpGTk4Ifmpr0FwNr6pXVg, 2026-11-12). The families are the Mona Sans family (2026-11-17): Mona Sans Display for headings and display styles, Mona Sans for text styles and Mona Sans Mono for mono styles. The text styles (semantic.type) and the creative sizes are this repo's own: the type set adopted on 2026-11-18. Mona Sans always renders with ss05 and ss06 on. There are no letter-spacing primitives since 2026-11-18: every text style uses 0, the font's default.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans",
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ],
          "$description": "Figma font-family/primary."
        },
        "display": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Display",
            "Mona Sans",
            "ui-sans-serif",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Headings and display styles. Mona Sans at its Display optical size (opsz 72), the cut the font names Display: fonts/fonts.css defines \"Mona Sans Display\" from the same variable font, so no extra file is needed."
        },
        "condensed": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Display Condensed",
            "Mona Sans Display",
            "Mona Sans",
            "ui-sans-serif",
            "system-ui",
            "sans-serif"
          ],
          "$description": "The condensed display styles. The font's Display Condensed, 75% width at the Display optical size: fonts/fonts.css defines \"Mona Sans Display Condensed\" from the same variable font."
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Mono",
            "ui-monospace",
            "SF Mono",
            "Menlo",
            "Consolas",
