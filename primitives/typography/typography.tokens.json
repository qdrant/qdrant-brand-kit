            "maxWords": 10,
            "wide": "104px",
            "ultrawide": "104px"
          }
        }
      },
      "title-long": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Title of 11 words or more",
        "$extensions": {
          "qdrant": {
            "story": "72px",
            "maxWords": null,
            "wide": "88px",
            "ultrawide": "88px"
          }
        }
      },
      "supporting": {
