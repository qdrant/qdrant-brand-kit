    "creative": {
      "$description": "Text in creatives (social posts, ads, banners). Two sizes only: one title, one supporting size. px at the shape's reference canvas, scaled with the canvas. $value is square and portrait; $extensions.qdrant.story and .wide are those shapes. $extensions.qdrant.ultrawide is ultrawide (same as wide, decided 2026-11-11 from the LinkedIn cover). Decided by Vanesa 2026-11-04.",
      "title-short": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "Title up to 6 words. Mona Sans SemiBold, Title Case, line height 1.05, letter spacing -1.8px",
        "$extensions": {
          "qdrant": {
            "story": "104px",
            "maxWords": 6,
            "wide": "128px",
            "ultrawide": "128px"
          }
        }
      },
      "title-medium": {
        "$type": "dimension",
        "$value": "80px",
