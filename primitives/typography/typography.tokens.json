{
  "$description": "Qdrant typography. Weights and the size, line-height and letter-spacing scales match the Figma file Qdrant Design System Primitives (UUpGTk4Ifmpr0FwNr6pXVg, 2026-11-12). The families are the Mona Sans family (2026-11-17): Mona Sans Display for headings and display styles, Mona Sans for text styles and Mona Sans Mono for mono styles. The text styles and creative sizes are this repo's own and unchanged. Mona Sans always renders with ss05 and ss06 on.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans",
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ],
          "$description": "Figma font-family/primary."
        },
        "display": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Display",
            "Mona Sans",
            "ui-sans-serif",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Headings and display styles. Mona Sans at its Display optical size (opsz 72), the cut the font names Display: fonts/fonts.css defines \"Mona Sans Display\" from the same variable font, so no extra file is needed."
        },
        "condensed": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Condensed",
            "Mona Sans Display",
            "Mona Sans",
            "ui-sans-serif",
            "system-ui",
            "sans-serif"
          ],
          "$description": "The condensed display styles. The font's Display Condensed, 75% width at the Display optical size: fonts/fonts.css defines \"Mona Sans Condensed\" from the same variable font."
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Mono",
            "ui-monospace",
            "SF Mono",
            "Menlo",
            "Consolas",
            "monospace"
          ],
          "$description": "Mono styles, labels and code. fonts/MonaSansMonoVF[wght].ttf."
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
      "featureSettings": {
        "$type": "string",
        "$value": "\"ss05\" on, \"ss06\" on",
        "$description": "Required for Mona Sans: double-storey a (ss05) and g (ss06)"
      },
