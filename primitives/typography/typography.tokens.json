{
  "$description": "Qdrant typography. Families, weights and the size, line-height and letter-spacing scales match the Figma file Qdrant Design System Primitives (UUpGTk4Ifmpr0FwNr6pXVg, 2026-11-12). The text styles and creative sizes are this repo's own and unchanged. Mona Sans always renders with ss05 and ss06 on.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans",
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ],
          "$description": "Figma font-family/primary."
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "Geist Mono",
            "JetBrains Mono",
            "Fira Code",
            "SF Mono",
            "Consolas",
            "monospace"
          ]
        },
        "display": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans Condensed",
            "Mona Sans",
            "ui-sans-serif",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Figma font-family/display. Mona Sans at 75% width: fonts/fonts.css defines \"Mona Sans Condensed\" from the variable font, so no extra file is needed."
        }
      },
      "weight": {
        "light": {
          "$type": "fontWeight",
          "$value": 300,
          "$description": "Figma font-weight/light."
        },
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
      "featureSettings": {
        "$type": "string",
        "$value": "\"ss05\" on, \"ss06\" on",
        "$description": "Required for Mona Sans: double-storey a (ss05) and g (ss06)"
      },
      "size": {
        "$description": "Figma font-size scale, in px. The text styles below and the creative sizes keep their own values; new web UI picks from this scale.",
        "10": {
          "$type": "dimension",
          "$value": "10px"
        },
        "12": {
          "$type": "dimension",
          "$value": "12px"
        },
        "13": {
          "$type": "dimension",
          "$value": "13px"
        },
        "14": {
          "$type": "dimension",
          "$value": "14px"
        },
        "15": {
          "$type": "dimension",
          "$value": "15px"
        },
        "16": {
          "$type": "dimension",
          "$value": "16px"
        },
        "18": {
          "$type": "dimension",
          "$value": "18px"
        },
        "20": {
          "$type": "dimension",
          "$value": "20px"
        },
        "24": {
          "$type": "dimension",
          "$value": "24px"
        },
        "32": {
          "$type": "dimension",
          "$value": "32px"
        },
        "36": {
          "$type": "dimension",
          "$value": "36px"
        },
        "40": {
          "$type": "dimension",
          "$value": "40px"
        },
        "48": {
          "$type": "dimension",
          "$value": "48px"
        },
        "56": {
          "$type": "dimension",
          "$value": "56px"
        },
        "64": {
          "$type": "dimension",
          "$value": "64px"
        }
      },
      "lineHeight": {
        "$description": "Figma line-height scale (unitless multipliers).",
        "none": {
          "$type": "number",
          "$value": 1
        },
        "tight": {
          "$type": "number",
          "$value": 1.2
        },
        "snug": {
          "$type": "number",
          "$value": 1.35
        },
        "normal": {
          "$type": "number",
          "$value": 1.5
        },
        "relaxed": {
          "$type": "number",
          "$value": 1.7
        }
      },
      "letterSpacing": {
        "$description": "Figma letter-spacing scale, fixed px as in Figma, so the same value gives the same spacing at any size.",
        "tighter": {
          "$type": "dimension",
          "$value": "-1.5px"
        },
        "tight": {
          "$type": "dimension",
          "$value": "-1px"
        },
        "snug": {
          "$type": "dimension",
          "$value": "-0.5px"
        },
        "normal": {
          "$type": "dimension",
          "$value": "0px"
        }
      }
    }
  },
