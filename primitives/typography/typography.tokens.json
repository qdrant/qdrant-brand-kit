    "creative": {
      "$description": "Text in creatives (social posts, ads, banners). Two sizes only: one title, one supporting size. px at the shape's reference canvas, scaled with the canvas. $value is square and portrait; $extensions.qdrant.story, .wide and .ultrawide are those shapes. Every size is a step of the type set (semantic.type), with that step's line height and letter spacing 0 (Juan, 2026-11-18). Decided by Vanesa 2026-11-04; ultrawide like wide since 2026-11-11.",
      "title-short": {
        "$type": "dimension",
        "$value": "104px",
        "$description": "Title up to 6 words. Mona Sans Display SemiBold, Title Case. Display 2 (104px, line height 1.06); Display 3 (128px, 1.05) on wide and ultrawide",
        "$extensions": {
          "qdrant": {
            "story": "104px",
            "maxWords": 6,
            "wide": "128px",
            "ultrawide": "128px"
          }
        }
      },
      "title-medium": {
        "$type": "dimension",
        "$value": "80px",
        "$description": "Title of 7 to 10 words. Display 1 (80px, line height 1.08); Display 2 (104px, 1.06) on wide and ultrawide",
        "$extensions": {
          "qdrant": {
            "story": "80px",
            "maxWords": 10,
            "wide": "104px",
            "ultrawide": "104px"
          }
        }
      },
      "title-long": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Title of 11 words or more. H1 (64px, line height 1.1); Display 1 (80px, 1.08) on wide and ultrawide",
        "$extensions": {
          "qdrant": {
            "story": "64px",
            "maxWords": null,
            "wide": "80px",
            "ultrawide": "80px"
          }
        }
      },
