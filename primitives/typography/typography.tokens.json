        }
      },
      "letterSpacing": {
        "$description": "Letter-spacing scale, fixed px as in Figma, so the same value gives the same spacing at any size. Every text style uses normal (0) since 2026-11-17: Mona Sans Display is already tighter than the text cut. The negative steps are for UI.",
        "tighter": {
          "$type": "dimension",
          "$value": "-1.5px"
        },
        "tight": {
          "$type": "dimension",
          "$value": "-1px"
        },
        "snug": {
          "$type": "dimension",
          "$value": "-0.5px"
        },
        "normal": {
          "$type": "dimension",
          "$value": "0px"
        }
      }
    }
