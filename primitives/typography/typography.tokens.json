{
  "$description": "Qdrant typography. Values from the qdrant-brand skill (qdrant/skills-internal skills/design), interim until Juan's design system lands. Mona Sans always renders with ss05 and ss06 on.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Mona Sans",
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ]
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "Geist Mono",
            "JetBrains Mono",
            "Fira Code",
            "SF Mono",
            "Consolas",
            "monospace"
          ]
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
      "featureSettings": {
        "$type": "string",
        "$value": "\"ss05\" on, \"ss06\" on",
        "$description": "Required for Mona Sans: double-storey a (ss05) and g (ss06)"
      }
    }
  },
  "semantic": {
    "type": {
      "display-2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "104px",
          "fontWeight": 700,
          "lineHeight": 1.05,
          "letterSpacing": "-1.8px"
        }
      },
      "display-1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "80px",
          "fontWeight": 600,
          "lineHeight": 1.05,
          "letterSpacing": "-1.8px"
        }
      },
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "64px",
          "fontWeight": 600,
          "lineHeight": 1.1,
          "letterSpacing": "-1.5px"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "56px",
          "fontWeight": 600,
          "lineHeight": 1.1,
          "letterSpacing": "-0.5px"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
