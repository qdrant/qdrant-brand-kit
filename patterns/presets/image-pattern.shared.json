{
  "$description": "Shared by every image preset (Image-Refracted-Pattern and Image-Sliced-Pattern). Change a value here and all of them update.",
  "extends": "shared",
  "source": {
    "$description": "Placeholder. In the tool, the source image is picked from the Design Lab library at render time, so every new library image can become a new pattern.",
    "from": "design-lab-library",
    "pick": "random",
    "filter": {
      "assetType": "image",
      "approvedOnly": true,
      "moodboard": "Default",
      "excludePromptWords": [
        "mascot",
        "robot"
      ]
    },
    "never": [
      "Mascot images (asset type mascot)",
      "Images with the mascot in them, even when the asset type is image. Asset type alone isn't enough, so prompts that mention the mascot or a robot are skipped, and a person should confirm new images.",
      "Luma or event promo images (asset type event)"
    ]
  },
  "examples": [
    {
      "name": "Astronauts over crater",
      "image": "sources/astronauts-crater.webp",
      "library": "Shared by Vanesa"
    },
    {
      "name": "Splitting the Ice Block",
      "image": "sources/splitting-the-ice-block.png",
      "library": "https://qdrant-design-lab.vercel.app/library/8d9b1e13-f792-46de-9174-e4ee7566f3cb"
    },
    {
      "name": "Astronaut Drives Lunar Rover",
      "image": "sources/astronaut-drives-lunar-rover.png",
      "library": "https://qdrant-design-lab.vercel.app/library/d7ddde24-69d5-402e-b72d-0a7fc107248e"
    },
    {
      "name": "Astronaut Holds Exploding Orb",
      "image": "sources/astronaut-holds-exploding-orb.png",
      "library": "https://qdrant-design-lab.vercel.app/library/6d581177-6af1-4ee3-9f97-6b6671de491d"
    }
  ],
  "settings": {
    "size": 1080,
    "grade": {
      "anchors": [
        "{color.primary.500}",
        "{color.secondary.500}"
      ],
      "hueSnap": 100,
      "minSaturation": 45,
      "minLightness": 40,
      "maxLightness": 97,
      "lift": 0.3
    },
    "blur": {
      "radius": 1000
    },
    "contrast": {
      "low": 15,
      "high": 98,
      "curve": 70,
      "midtones": 0.6
    }
  }
}
